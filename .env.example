# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Módulo financeiro (Asaas) — NUNCA commitar valores reais ---
# Banco: conexão direta com o papel restrito antum_fin (só enxerga o schema "financeiro").
# Formato: postgresql://antum_fin.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
FIN_DATABASE_URL=""
# Asaas: sandbox por padrão. Produção só com ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
# Token do webhook (32+ caracteres, não pode ser a chave da API) — o mesmo cadastrado no Asaas
ASAAS_WEBHOOK_TOKEN=""
# Token do painel admin (32+ caracteres) para gerar convites
FIN_ADMIN_TOKEN=""
SITE_URL="https://antum.com.br"
ALLOWED_ORIGINS="https://antum.com.br,https://www.antum.com.br"
